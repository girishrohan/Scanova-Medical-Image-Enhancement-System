{
  "version": 2,
  "name": "scanova-medical-imaging",
  "builds": [
    {
      "src": "next.config.ts",
      "configureCommand": "npm run build",
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    }
  ],
  "routes": [
    {
      "src": "/samples/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_NAME": "Scanova",
    "NEXT_PUBLIC_APP_VERSION": "1.0.0"
  }
}